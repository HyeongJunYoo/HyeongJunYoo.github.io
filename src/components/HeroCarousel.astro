---
import type { Project } from "../data/projects";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const initialTone = projects[0]?.tone ?? "acid";
---

<section
  class="hero-carousel"
  data-hero-carousel
  style={`--tone: var(--${initialTone});`}
  role="region"
  aria-roledescription="carousel"
  aria-label="대표 프로젝트"
>
  <div class="hero-carousel-viewport" data-hero-viewport>
    {projects.map((project, index) => (
      <a
        href={`/portfolio/${project.id}`}
        class:list={["featured-hero", "hero-slide", { "is-active": index === 0 }]}
        data-hero-slide
        data-index={index}
        data-tone={project.tone}
        style={`--tone: var(--${project.tone});`}
        aria-hidden={index === 0 ? "false" : "true"}
        tabindex={index === 0 ? 0 : -1}
        aria-label={`${project.title} 케이스 보기`}
      >
        <div class="hero-media hud-frame" aria-hidden="true">
          <span class="hud-corner-tr"></span>
          <span class="hud-corner-bl"></span>
          <img
            src={project.image}
            alt=""
            loading={index === 0 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : "auto"}
            decoding="async"
            draggable={false}
          />
          <span class="hero-scrim"></span>
        </div>
        <div class="hero-overlay">
          <span class="hero-eyebrow">
            <span>{project.genre}</span>
            <span>{project.period}</span>
          </span>
          <span class="hero-title">{project.title}</span>
          <span class="hero-summary">{project.summary}</span>
        </div>
      </a>
    ))}
  </div>

  <div class="hero-nav-numbers" role="group" aria-label="대표 프로젝트 선택">
    {projects.map((project, index) => (
      <button
        type="button"
        class:list={["hero-num", { "is-active": index === 0 }]}
        data-hero-number
        data-index={index}
        aria-label={`${index + 1}번: ${project.title}`}
        aria-pressed={index === 0 ? "true" : "false"}
      >{index + 1}</button>
    ))}
  </div>

  <button type="button" class="hero-nav-arrow is-prev" data-hero-prev aria-label="이전 프로젝트">‹</button>
  <button type="button" class="hero-nav-arrow is-next" data-hero-next aria-label="다음 프로젝트">›</button>
</section>

<script>
  (() => {
    const root = document.querySelector("[data-hero-carousel]");
    if (!root) return;

    const slides = Array.from(root.querySelectorAll("[data-hero-slide]"));
    const numbers = Array.from(root.querySelectorAll("[data-hero-number]"));
    const prevBtn = root.querySelector("[data-hero-prev]");
    const nextBtn = root.querySelector("[data-hero-next]");
    const count = slides.length;
    if (count === 0) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const AUTOPLAY_MS = 6000;
    const DRAG_THRESHOLD = 40;

    let active = 0;
    let dragging = false;
    let suppressClick = false;
    let startX = 0;
    let autoplayTimer = 0;

    const wrap = (i) => ((i % count) + count) % count;

    const render = (target, dir) => {
      const next = wrap(target);
      if (next === active) return;
      root.setAttribute("data-dir", dir);
      slides.forEach((slide, i) => {
        const on = i === next;
        slide.classList.toggle("is-active", on);
        slide.setAttribute("aria-hidden", on ? "false" : "true");
        slide.setAttribute("tabindex", on ? "0" : "-1");
      });
      numbers.forEach((btn, i) => {
        const on = i === next;
        btn.classList.toggle("is-active", on);
        btn.setAttribute("aria-pressed", on ? "true" : "false");
      });
      const tone = slides[next].getAttribute("data-tone") || "acid";
      root.style.setProperty("--tone", `var(--${tone})`);
      active = next;
    };

    const next = () => render(active + 1, "next");
    const prev = () => render(active - 1, "prev");
    const goTo = (i) => {
      const target = wrap(i);
      if (target === active) return;
      let diff = target - active;
      if (diff > count / 2) diff -= count;
      if (diff < -count / 2) diff += count;
      render(target, diff > 0 ? "next" : "prev");
    };

    const stopAutoplay = () => {
      if (autoplayTimer) { window.clearInterval(autoplayTimer); autoplayTimer = 0; }
    };
    const startAutoplay = () => {
      if (reduceMotion) return;
      stopAutoplay();
      autoplayTimer = window.setInterval(next, AUTOPLAY_MS);
    };
    const restartAutoplay = () => { if (!reduceMotion) startAutoplay(); };

    // Number + arrow controls (stop the event so the slide-link doesn't fire).
    numbers.forEach((btn) => {
      btn.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        goTo(Number(btn.getAttribute("data-index") || 0));
        restartAutoplay();
      });
    });
    nextBtn?.addEventListener("click", (event) => {
      event.preventDefault(); event.stopPropagation(); next(); restartAutoplay();
    });
    prevBtn?.addEventListener("click", (event) => {
      event.preventDefault(); event.stopPropagation(); prev(); restartAutoplay();
    });

    // Slide click navigates to the detail page, unless the press was a drag.
    slides.forEach((slide) => {
      slide.addEventListener("click", (event) => {
        if (suppressClick) { event.preventDefault(); suppressClick = false; }
      });
    });

    // Keyboard: arrows when focus is inside the carousel.
    root.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") { event.preventDefault(); next(); restartAutoplay(); }
      else if (event.key === "ArrowLeft") { event.preventDefault(); prev(); restartAutoplay(); }
    });

    // Swipe / drag.
    root.addEventListener("pointerdown", (event) => {
      if (event.target instanceof Element && event.target.closest("button")) return;
      if (event.pointerType === "mouse" && event.button !== 0) return;
      dragging = true;
      suppressClick = false;
      startX = event.clientX;
    });
    root.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      if (Math.abs(event.clientX - startX) > 10) suppressClick = true;
    });
    const endDrag = (event) => {
      if (!dragging) return;
      dragging = false;
      const dx = event.clientX - startX;
      if (Math.abs(dx) > DRAG_THRESHOLD) {
        if (dx < 0) next(); else prev();
        restartAutoplay();
      }
    };
    root.addEventListener("pointerup", endDrag);
    root.addEventListener("pointercancel", () => { dragging = false; });

    // Autoplay: pause on hover / focus, resume on leave / blur.
    root.addEventListener("pointerenter", stopAutoplay);
    root.addEventListener("pointerleave", startAutoplay);
    root.addEventListener("focusin", stopAutoplay);
    root.addEventListener("focusout", (event) => {
      if (!(event.relatedTarget instanceof Node) || !root.contains(event.relatedTarget)) {
        startAutoplay();
      }
    });

    startAutoplay();
  })();
</script>
