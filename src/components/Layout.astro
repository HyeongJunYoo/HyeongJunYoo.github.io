---
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "유형준 | Unity Client Developer",
  description = "Unity 기반 PC/VR 메타버스 플랫폼, 실시간 멀티 콘텐츠, SDK/제작 환경, 마커리스 모션 캡처 개발 경험을 정리한 웹 이력서입니다."
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f5" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://hyeongjunyoo.github.io/" />
    <meta property="og:image" content="https://hyeongjunyoo.github.io/og-image.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 이동</a>
    <slot />
  </body>
</html>
