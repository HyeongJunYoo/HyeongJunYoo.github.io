---
import Layout from "../components/Layout.astro";
import {
  activities,
  career,
  education,
  profile,
  skills
} from "../data/resume";
import { projects } from "../data/projects";

const activityPreviewLimit = 5;
const hasHiddenActivities = activities.length > activityPreviewLimit;
---

<Layout>
  <header class="site-header" aria-label="주요 메뉴">
    <nav class="site-nav">
      <a href="#about">About</a>
      <a href="#career">Career</a>
      <a href="#projects">Projects</a>
      <a href="#skills">Skills</a>
      <a href="#education">Education</a>
      <a href="#activities">Showcases</a>
    </nav>
    <button
      type="button"
      class="theme-toggle"
      data-theme-toggle
      aria-label="Toggle color theme"
      aria-pressed="false"
    >
      <span class="theme-toggle-track" aria-hidden="true">
        <span class="theme-toggle-thumb"></span>
      </span>
      <span class="theme-toggle-label" data-theme-label>Dark</span>
    </button>
  </header>

  <main id="main">
    <section id="top" class="hero section-block" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div class="profile-photo-slot" aria-hidden="true">
          <span>{profile.initials}</span>
        </div>
        <div class="hero-title-group">
          <h1 id="hero-title">{profile.name}</h1>
          <p class="role">{profile.role}</p>
        </div>
      </div>

      <div class="hero-aside" aria-label="연락처 및 링크">
        <nav class="profile-links" aria-label="외부 링크">
          {profile.links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noreferrer"
              aria-label={`${link.label} ${link.displayText}`}
            >
              <span
                class="link-icon"
                style={`--icon-url: url("${link.iconUrl}")`}
                aria-hidden="true"
              />
              <span class="link-value">{link.displayText}</span>
            </a>
          ))}
        </nav>
        <div class="contact-lines">
          <a
            class="contact-link"
            href={`mailto:${profile.contact.email}`}
            aria-label={`Email ${profile.contact.email}`}
          >
            <span
              class="link-icon"
              style={`--icon-url: url("${profile.contact.iconUrl}")`}
              aria-hidden="true"
            />
            <span class="link-value">{profile.contact.email}</span>
          </a>
        </div>
      </div>
    </section>

    <section id="about" class="section-block about-section" aria-labelledby="about-title">
      <div class="section-heading compact">
        <h2 id="about-title">About Me</h2>
      </div>
      <div class="about-body">
        {profile.summary.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section id="career" class="section-block" aria-labelledby="career-title">
      <div class="section-heading compact">
        <h2 id="career-title">Career</h2>
      </div>
      <div class="career-list">
        {career.map((item) => (
          <article class="career-item">
            <div class="entry-meta">
              <h3>{item.company}</h3>
              <p class="entry-period">{item.period}</p>
            </div>
            <div class="career-content">
              <p class="entry-subtitle">{item.team} · {item.role}</p>
              {item.summary && <p class="entry-summary">{item.summary}</p>}
              <ul class="check-list">
                {item.details.map((detail) => <li>{detail}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="projects" class="section-block" aria-labelledby="projects-title">
      <div class="section-heading compact">
        <h2 id="projects-title">Projects</h2>
      </div>

      <div class="project-timeline">
        {projects.map((project) => (
          <article class="project-card project-card-summary">
            <aside class="project-meta" aria-label={`${project.title} 요약`}>
              <h3>{project.title}</h3>
            </aside>
            <div class="project-content project-summary-content">
              <p class="project-tagline">{project.tagline}</p>
              <a class="project-more" href={`/portfolio/${project.id}`} aria-label={`${project.title} 자세히 보기`}>자세히 →</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="skills" class="section-block" aria-labelledby="skills-title">
      <div class="section-heading compact">
        <h2 id="skills-title">Skills</h2>
      </div>
      <div class="skill-list">
        {skills.map((group) => (
          <section class="skill-row">
            <h3>{group.title}</h3>
            <ul>
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        ))}
      </div>
    </section>

    <section id="education" class="section-block" aria-labelledby="education-title">
      <div class="section-heading compact">
        <h2 id="education-title">Education</h2>
      </div>
      <div class="education-list">
        {education.map((item) => (
          <article class="education-item">
            <div class="entry-meta">
              <h3>{item.title}</h3>
              <p class="entry-period">{item.period}</p>
            </div>
            <div class="education-content">
              <p class="entry-subtitle">{item.meta}</p>
              {item.details.length > 0 && (
                <ul class="check-list">
                  {item.details.map((detail) => <li>{detail}</li>)}
                </ul>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="activities" class="section-block" aria-labelledby="activities-title">
      <div class="section-heading compact">
        <h2 id="activities-title">Showcases & Workshops</h2>
      </div>
      <div id="activities-list" class="activity-list">
        {activities.map((activity, index) => (
          <article
            class={`activity-item${index >= activityPreviewLimit ? " activity-item-extra" : ""}`}
            data-activity-extra={index >= activityPreviewLimit ? "true" : undefined}
            hidden={index >= activityPreviewLimit}
          >
            <div class="entry-meta">
              <h3>{activity.title}</h3>
              <p class="entry-period">{activity.date}</p>
            </div>
            <div class="activity-content">
              <p class="entry-summary">{activity.description}</p>
            </div>
          </article>
        ))}
      </div>
      {hasHiddenActivities && (
        <div class="activity-actions">
          <button
            type="button"
            class="activity-toggle"
            data-activity-toggle
            aria-expanded="false"
            aria-controls="activities-list"
          >
            더 보기
          </button>
        </div>
      )}
    </section>

  </main>

  <footer class="site-footer">
    <p>© {new Date().getFullYear()} {profile.name}. Built as a maintainable web resume.</p>
    <a href="#top">Back to top</a>
  </footer>

  <script is:inline>
    const initResumeInteractions = () => {
    const navLinks = [...document.querySelectorAll(".site-nav a")];
    const sections = navLinks
      .map((link) => document.querySelector(link.getAttribute("href") || ""))
      .filter(Boolean);

    if ("IntersectionObserver" in window) {
      const navObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            navLinks.forEach((link) => {
              link.toggleAttribute("aria-current", link.getAttribute("href") === `#${entry.target.id}`);
            });
          });
        },
        { rootMargin: "-35% 0px -55% 0px" }
      );

      sections.forEach((section) => navObserver.observe(section));
    }

    const activityToggle = document.querySelector("[data-activity-toggle]");
    const activityExtras = [...document.querySelectorAll("[data-activity-extra]")];

    if (activityToggle && activityExtras.length > 0) {
      activityToggle.addEventListener("click", () => {
        const shouldExpand = activityToggle.getAttribute("aria-expanded") !== "true";

        activityToggle.setAttribute("aria-expanded", String(shouldExpand));
        activityToggle.textContent = shouldExpand ? "접기" : "더 보기";
        activityExtras.forEach((activity) => {
          activity.hidden = !shouldExpand;
        });
      });
    }

      const themeToggle = document.querySelector("[data-theme-toggle]");
      const themeLabel = document.querySelector("[data-theme-label]");
      const themeMeta = document.querySelector('meta[name="theme-color"]');
      const setTheme = (theme) => {
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        themeToggle?.setAttribute("aria-pressed", String(theme === "dark"));
        if (themeLabel) themeLabel.textContent = theme === "dark" ? "Light" : "Dark";
        if (themeMeta) themeMeta.setAttribute("content", theme === "dark" ? "#11110f" : "#f7f7f5");
      };

      const currentTheme = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
      setTheme(currentTheme);

      themeToggle?.addEventListener("click", () => {
        const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        setTheme(nextTheme);
        try {
          localStorage.setItem("resume-theme", nextTheme);
        } catch {
          // Theme preference remains session-only when storage is unavailable.
        }
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initResumeInteractions, { once: true });
    } else {
      initResumeInteractions();
    }
  </script>
</Layout>
