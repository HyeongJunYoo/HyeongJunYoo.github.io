const otherProjects = projects.slice(1);
---

<Layout
  title="Floating World Portfolio Prototype"
  description="A blank-slate exploratory portfolio prototype with a floating 3D project world and full-screen case study expansion."
>
  <div class="world-shell" data-world-shell data-mode="grid" data-active-tone={featuredProject.tone}>
    <div class="world-grain" aria-hidden="true"></div>
    <div class="scanlines" aria-hidden="true"></div>
    <div class="cursor-light" data-cursor aria-hidden="true"></div>

    <div class="system-ticker" aria-hidden="true">
      <span class="ticker-segment">
        <span class="ticker-dot"></span>
        <span class="ticker-label">SYS</span>
        <span class="ticker-value">ONLINE</span>
      </span>
      <span class="ticker-marquee" data-ticker-marquee>BUILD::PASS · PROJECTS_LOADED 5 · MODE::GRID · LATENCY 12ms</span>
      <span class="ticker-segment">
        <span class="ticker-label">v</span>
        <span class="ticker-value">0.0.4</span>
      </span>
    </div>

    <header class="world-header" aria-label="Site navigation">
      <a class="site-mark" href="/">● HYEONGJUN YOO <span>/ Game Programmer</span></a>
      <nav class="site-nav" aria-label="Primary">
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
        <a href="https://github.com/HyeongJunYoo" rel="noreferrer noopener" target="_blank">GitHub</a>
        <a href="https://www.linkedin.com/" rel="noreferrer noopener" target="_blank">LinkedIn</a>
      </nav>
    </header>

    <main id="main">
      <section class="featured-hero" data-tone={featuredProject.tone} aria-labelledby="hero-title">
        <div class="hero-media hud-frame" aria-hidden="true">
          <span class="hud-corner-tr"></span>
          <span class="hud-corner-bl"></span>
          <img src={featuredProject.image} alt="" />
          <span class="hero-scrim"></span>
        </div>
        <div class="hero-overlay">
          <p class="hero-eyebrow">
            <span>[{featuredProject.eyebrow.toUpperCase().replace(/\s+/g, "_")}]</span>
            <span>{featuredProject.period.split("·")[0].trim()} · {featuredProject.engine} · {featuredProject.genre} · {featuredProject.status}</span>
          </p>
          <h1 id="hero-title" class="hero-title decoded-text" data-decode-text>{featuredProject.title}</h1>
          <p class="hero-summary">{featuredProject.summary}</p>
          <div class="hero-cta">
            {featuredProject.links?.play && (
              <a class="hero-cta-primary" href={featuredProject.links.play}>▶ Play Demo</a>
            )}
            <button type="button" class="hero-cta-secondary" data-hero-case-study>Case Study →</button>
            {featuredProject.links?.source && (
              <a class="hero-cta-secondary" href={featuredProject.links.source}>Source</a>
            )}
          </div>
        </div>
      </section>

      <section class="world-stage" aria-labelledby="world-title">
        <div class="projects-section-header">
          <div class="projects-section-label">
            <p class="eyebrow">Other projects</p>
            <h2 id="world-title">Work archive</h2>
          </div>
          <div class="projects-section-controls" role="group" aria-label="Project view mode">
            <div class="mode-tabs">
              <button type="button" data-mode-button="grid" aria-pressed="true">Grid</button>
              <button type="button" data-mode-button="deck" aria-pressed="false">Deck</button>
              <button type="button" data-mode-button="world" aria-pressed="false">World</button>
            </div>
            <button type="button" class="sound-toggle" data-pause-toggle aria-pressed="false" aria-label="Pause globe motion">
              <span></span>
            </button>
          </div>
        </div>

        <div class="world-scene" data-world-scene aria-label="Floating card globe">
          <div class="world-halo" aria-hidden="true"></div>
          <div class="world-rotator" data-world-rotator>
            {projects.map((project, index) => (
              <button
                type="button"
                class={`world-card is-${project.level} ${project.id === featuredProject.id ? "is-hero" : ""}`}
                data-world-card
                data-project-index={index}
                data-card-id={project.id}
                data-title={project.title}
                data-eyebrow={project.eyebrow}
                data-summary={project.summary}
                data-what-i-built={project.whatIBuilt}
                data-role={project.role}
                data-period={project.period}
                data-engine={project.engine}
                data-platform={project.platform}
                data-genre={project.genre}
                data-team={project.team}
                data-status={project.status}
                data-image={project.image}
                data-tone={project.tone}
                data-level={project.level}
                data-stack={project.stack.join("|")}
                data-stats={JSON.stringify(project.stats || [])}
                data-gallery={JSON.stringify(project.gallery || [])}
                data-links={JSON.stringify(project.links || {})}
                aria-pressed={index === 0 ? "true" : "false"}
                style={`
                  --card-tone: var(--${project.tone});
                  --theta: ${project.theta}deg;
                  --phi: ${project.phi}deg;
                  --theta-back: ${-project.theta}deg;
                  --phi-back: ${-project.phi}deg;
                  --w: ${project.width}px;
                  --h: ${project.height}px;
                  --gx: ${project.gridX}px;
                  --gy: ${project.gridY}px;
                  --delay: ${index * -0.12}s;
                  --deck-x: 0px;
                  --deck-y: 0px;
                  --deck-z: 0px;
                  --deck-rotate: 0deg;
                  --deck-scale: 1;
                  --deck-opacity: 1;
                  --deck-z-index: ${100 - index};
                `}
              >
                <span class="card-inner hud-frame">
                  <span class="hud-corner-tr"></span>
                  <span class="hud-corner-bl"></span>
                  <img src={project.image} alt="" loading={index > 1 ? "lazy" : "eager"} decoding="async" />
                  <span class="card-scrim"></span>
                  <span class="card-status">[{project.status.toUpperCase()}]</span>
                  <span class="card-eyebrow">{project.eyebrow.toUpperCase().replace(/\s+/g, "·")}</span>
                  <span class="card-meta">
                    <strong>{project.title}</strong>
                    <span>{project.engine} · {project.genre} · {project.period.split("·")[0].trim()}</span>
                  </span>
                </span>
              </button>
            ))}
          </div>
        </div>

        <div class="world-controls">
          <button type="button" class="control-primary" data-random-card>Explore</button>
          <button type="button" class="control-secondary" data-reset-world>Reset</button>
        </div>

        <p class="world-hint">Drag the world. Hover a card. Click one project to expand it into a full-screen case study.</p>
      </section>

      <section class="project-detail" data-project-detail aria-hidden="true" aria-labelledby="detail-title">
        <button type="button" class="detail-close" data-detail-close aria-label="Back to project world">Back to world</button>

        <div class="detail-hero-media hud-frame" data-detail-hero-media aria-hidden="true">
          <span class="hud-corner-tr"></span>
          <span class="hud-corner-bl"></span>
          <img data-detail-image src={featuredProject.image} alt="" />
          <span class="detail-hero-scrim"></span>
        </div>

        <article class="detail-content">
          <p class="detail-eyebrow" data-detail-eyebrow>{featuredProject.eyebrow}</p>
          <h2 id="detail-title" data-detail-title>{featuredProject.title}</h2>
          <p class="detail-summary" data-detail-summary>{featuredProject.summary}</p>

          <div class="detail-cta" data-detail-cta hidden>
          </div>

          <dl class="detail-meta">
            <div>
              <dt>Engine</dt>
              <dd data-detail-engine>{featuredProject.engine}</dd>
            </div>
            <div>
              <dt>Platform</dt>
              <dd data-detail-platform>{featuredProject.platform}</dd>
            </div>
            <div>
              <dt>Role</dt>
              <dd data-detail-role>{featuredProject.role}</dd>
            </div>
            <div>
              <dt>Team / Period</dt>
              <dd data-detail-team>{featuredProject.team} · {featuredProject.period}</dd>
            </div>
          </dl>

          <section class="detail-narrative">
            <h3>What I built</h3>
            <p data-detail-what-i-built>{featuredProject.whatIBuilt}</p>
          </section>

          <section class="detail-gallery" data-detail-gallery hidden>
          </section>

          <section class="detail-stats" data-detail-stats hidden>
          </section>

          <div class="detail-stack" data-detail-stack>
            {featuredProject.stack.map((item) => <span>{item}</span>)}
          </div>
        </article>

        <div class="detail-nav">
          <button type="button" data-detail-prev>Previous</button>
          <button type="button" data-detail-next>Next</button>
        </div>
      </section>
    </main>

    <footer class="portfolio-footer" id="contact">
      <p class="portfolio-footer-about" id="about">
        Game programmer. Unity / Unreal · multiplayer · tools · tech-art-friendly.
      </p>
      <p class="portfolio-footer-links">
        <a href="mailto:yoojoo97@gmail.com">yoojoo97@gmail.com</a>
        <a href="https://github.com/HyeongJunYoo" rel="noreferrer noopener" target="_blank">GitHub</a>
        <a href="https://www.linkedin.com/" rel="noreferrer noopener" target="_blank">LinkedIn</a>
      </p>
    </footer>
  </div>

  <script is:inline>
    (() => {
      const root = document.documentElement;
      const shell = document.querySelector("[data-world-shell]");
      const scene = document.querySelector("[data-world-scene]");
      const rotator = document.querySelector("[data-world-rotator]");
      const cards = [...document.querySelectorAll("[data-world-card]")];
      const cursor = document.querySelector("[data-cursor]");
      const randomButton = document.querySelector("[data-random-card]");
      const resetButton = document.querySelector("[data-reset-world]");
      const pauseButton = document.querySelector("[data-pause-toggle]");
      const modeButtons = [...document.querySelectorAll("[data-mode-button]")];
      const detail = document.querySelector("[data-project-detail]");
      const detailClose = document.querySelector("[data-detail-close]");
      const detailPrev = document.querySelector("[data-detail-prev]");
      const detailNext = document.querySelector("[data-detail-next]");
      const detailImage = document.querySelector("[data-detail-image]");
      const detailEyebrow = document.querySelector("[data-detail-eyebrow]");
      const detailTitle = document.querySelector("[data-detail-title]");
      const detailSummary = document.querySelector("[data-detail-summary]");
      const detailEngine = document.querySelector("[data-detail-engine]");
      const detailPlatform = document.querySelector("[data-detail-platform]");
      const detailRole = document.querySelector("[data-detail-role]");
      const detailTeam = document.querySelector("[data-detail-team]");
      const detailWhatIBuilt = document.querySelector("[data-detail-what-i-built]");
      const detailStats = document.querySelector("[data-detail-stats]");
      const detailGallery = document.querySelector("[data-detail-gallery]");
      const detailCta = document.querySelector("[data-detail-cta]");
      const detailStack = document.querySelector("[data-detail-stack]");
      const themeMeta = document.querySelector('meta[name="theme-color"]');

      let spin = 0;
      let dragX = 0;
      let dragY = -9;
      let pointerDown = false;
      let startX = 0;
      let startY = 0;
      let startDragX = 0;
      let startDragY = 0;
      let paused = false;
      let activeIndex = 0;
      let deckPosition = 0;
      let deckTarget = 0;
      let deckWasDragged = false;
      let deckPointerDown = false;
      let worldPointerDown = false;
      let worldWasDragged = false;
      let skipNextCardClick = false;

      if (themeMeta) themeMeta.setAttribute("content", "#0c0c0c");

      const setVars = () => {
        const worldRotateX = -8 + dragY;
        const worldRotateY = spin + dragX;

        rotator?.style.setProperty("--spin", `${spin.toFixed(3)}deg`);
        rotator?.style.setProperty("--drag-x", `${dragX.toFixed(3)}deg`);
        rotator?.style.setProperty("--drag-y", `${dragY.toFixed(3)}deg`);
        rotator?.style.setProperty("--world-rotate-x", `${worldRotateX.toFixed(3)}deg`);
        rotator?.style.setProperty("--world-rotate-y", `${worldRotateY.toFixed(3)}deg`);
        rotator?.style.setProperty("--world-rotate-x-inverse", `${(-worldRotateX).toFixed(3)}deg`);
        rotator?.style.setProperty("--world-rotate-y-inverse", `${(-worldRotateY).toFixed(3)}deg`);
      };

      const setMode = (mode) => {
        shell?.setAttribute("data-mode", mode);
        modeButtons.forEach((button) => {
          button.setAttribute("aria-pressed", String(button.dataset.modeButton === mode));
        });

        if (mode === "deck") {
          updateDeck();
        }
      };

      const wrapIndex = (index) => ((index % cards.length) + cards.length) % cards.length;

      const getCircularDelta = (index, position) => {
        const count = cards.length;
        let delta = index - wrapIndex(position);

        if (delta > count / 2) delta -= count;
        if (delta < -count / 2) delta += count;

        return delta;
      };

      const setDeckTarget = (index) => {
        deckTarget += getCircularDelta(index, deckTarget);
      };

      const updateDeck = () => {
        const maxVisible = 4;
        const nearestIndex = wrapIndex(Math.round(deckPosition));

        cards.forEach((card, index) => {
          const delta = getCircularDelta(index, deckPosition);
          const abs = Math.abs(delta);
          const clamped = Math.max(-maxVisible, Math.min(maxVisible, delta));
          const side = clamped < 0 ? -1 : 1;
          const hidden = abs > maxVisible + 0.75;

          card.style.setProperty("--deck-x", `${clamped * 128}px`);
          card.style.setProperty("--deck-y", `${abs * 8}px`);
          card.style.setProperty("--deck-z", `${abs * -82}px`);
          card.style.setProperty("--deck-rotate", `${clamped * -9}deg`);
          card.style.setProperty("--deck-scale", `${Math.max(0.64, 1 - abs * 0.075)}`);
          card.style.setProperty("--deck-opacity", hidden ? "0" : `${Math.max(0.28, 1 - abs * 0.16)}`);
          card.style.setProperty("--deck-z-index", `${100 - Math.round(abs * 10)}`);
          card.style.setProperty("--deck-peek", `${side * Math.min(abs, maxVisible) * 16}px`);
          card.dataset.deckDistance = abs.toFixed(3);
          card.toggleAttribute("data-deck-current", index === nearestIndex);
        });

        const activeCard = cards[nearestIndex];
        if (activeCard && activeIndex !== nearestIndex) setActiveCard(activeCard, false);
      };

      const moveDeck = (direction) => {
        deckTarget += direction;
      };

      const isInterfaceInput = (target) => {
        if (!(target instanceof Element)) return false;
        if (target.closest("[data-world-card]")) return false;

        return Boolean(target.closest("a, button, input, textarea, select, .world-header, .world-controls, [data-project-detail]"));
      };

      const getDeckCardAtPoint = (clientX, clientY) => {
        let bestCard = null;
        let bestScore = Number.POSITIVE_INFINITY;

        cards.forEach((card) => {
          const opacity = Number.parseFloat(card.style.getPropertyValue("--deck-opacity") || "1");
          if (opacity <= 0.04) return;

          const rect = card.getBoundingClientRect();
          if (rect.width <= 0 || rect.height <= 0) return;

          const padX = rect.width * 0.08;
          const padY = rect.height * 0.06;
          const isInside =
            clientX >= rect.left - padX &&
            clientX <= rect.right + padX &&
            clientY >= rect.top - padY &&
            clientY <= rect.bottom + padY;

          if (!isInside) return;

          const centerX = rect.left + rect.width / 2;
          const centerY = rect.top + rect.height / 2;
          const normalizedX = Math.abs(clientX - centerX) / rect.width;
          const normalizedY = Math.abs(clientY - centerY) / rect.height;
          const deckDistance = Number.parseFloat(card.dataset.deckDistance || "0");
          const score = Math.hypot(normalizedX * 1.24, normalizedY) + deckDistance * 0.04;

          if (score < bestScore) {
            bestScore = score;
            bestCard = card;
          }
        });

        return bestCard;
      };

      const selectDeckCard = (card) => {
        if (!card) return;

        if (card.hasAttribute("data-deck-current")) {
          openDetail(card);
          return;
        }

        setDeckTarget(Number(card.dataset.projectIndex || 0));
      };

      const getWorldCardAtPoint = (clientX, clientY) => {
        let bestCard = null;
        let bestScore = Number.POSITIVE_INFINITY;

        cards.forEach((card) => {
          const opacity = Number.parseFloat(window.getComputedStyle(card).opacity || "1");
          if (opacity <= 0.04) return;

          const rect = card.getBoundingClientRect();
          if (rect.width <= 0 || rect.height <= 0) return;

          const padX = rect.width * 0.1;
          const padY = rect.height * 0.1;
          const isInside =
            clientX >= rect.left - padX &&
            clientX <= rect.right + padX &&
            clientY >= rect.top - padY &&
            clientY <= rect.bottom + padY;

          if (!isInside) return;

          const centerX = rect.left + rect.width / 2;
          const centerY = rect.top + rect.height / 2;
          const normalizedX = Math.abs(clientX - centerX) / rect.width;
          const normalizedY = Math.abs(clientY - centerY) / rect.height;
          const score = Math.hypot(normalizedX, normalizedY);

          if (score < bestScore) {
            bestScore = score;
            bestCard = card;
          }
        });

        return bestCard;
      };

      const selectWorldCard = (card, shouldSkipNativeClick = false) => {
        if (!card) return;

        skipNextCardClick = shouldSkipNativeClick;
        if (shouldSkipNativeClick) {
          window.setTimeout(() => {
            skipNextCardClick = false;
          }, 0);
        }
        openDetail(card);
      };

      const replaceStack = (value) => {
        if (!detailStack) return;

        detailStack.replaceChildren();
        value
          .split("|")
          .filter(Boolean)
          .forEach((item) => {
            const element = document.createElement("span");
            element.textContent = item;
            detailStack.appendChild(element);
          });
      };

      const setActiveCard = (card, shouldPulse = true) => {
        activeIndex = Number(card.dataset.projectIndex || 0);

        cards.forEach((item) => {
          item.setAttribute("aria-pressed", String(item === card));
        });

        const tone = card.dataset.tone || "acid";
        shell?.setAttribute("data-active-tone", tone);
        detail?.setAttribute("data-tone", tone);

        if (detailImage instanceof HTMLImageElement) detailImage.src = card.dataset.image || "";
        if (detailEyebrow) detailEyebrow.textContent = card.dataset.eyebrow || "";
        if (detailTitle) detailTitle.textContent = card.dataset.title || "";
        if (detailSummary) detailSummary.textContent = card.dataset.summary || "";
        if (detailEngine) detailEngine.textContent = card.dataset.engine || "";
        if (detailPlatform) detailPlatform.textContent = card.dataset.platform || "";
        if (detailRole) detailRole.textContent = card.dataset.role || "";
        if (detailTeam) detailTeam.textContent = [card.dataset.team, card.dataset.period].filter(Boolean).join(" · ");
        if (detailWhatIBuilt) detailWhatIBuilt.textContent = card.dataset.whatIBuilt || "";
        replaceStack(card.dataset.stack || "");

        if (detailStats) {
          let stats = [];
          try {
            stats = JSON.parse(card.dataset.stats || "[]");
          } catch (error) {
            stats = [];
          }
          detailStats.replaceChildren();
          if (stats.length > 0) {
            detailStats.removeAttribute("hidden");
            stats.forEach((stat) => {
              const statEl = document.createElement("div");
              statEl.className = "stat";
              const value = document.createElement("span");
              value.className = "stat-value";
              value.textContent = stat.value;
              const label = document.createElement("span");
              label.className = "stat-label";
              label.textContent = stat.label;
              statEl.append(value, label);
              detailStats.append(statEl);
            });
          } else {
            detailStats.setAttribute("hidden", "");
          }
        }

        if (detailGallery) {
          let gallery = [];
          try {
            gallery = JSON.parse(card.dataset.gallery || "[]");
          } catch (error) {
            gallery = [];
          }
          detailGallery.replaceChildren();
          if (gallery.length > 0) {
            detailGallery.removeAttribute("hidden");
            gallery.forEach((src) => {
              const img = document.createElement("img");
              img.src = src;
              img.alt = "";
              img.loading = "lazy";
              img.decoding = "async";
              detailGallery.append(img);
            });
          } else {
            detailGallery.setAttribute("hidden", "");
          }
        }

        if (detailCta) {
          let links = {};
          try {
            links = JSON.parse(card.dataset.links || "{}");
          } catch (error) {
            links = {};
          }
          detailCta.replaceChildren();
          const entries = [];
          if (links.play) entries.push({ key: "play", label: "▶ Play", primary: true, href: links.play });
          if (links.source) entries.push({ key: "source", label: "Source", primary: false, href: links.source });
          if (links.devlog) entries.push({ key: "devlog", label: "Devlog", primary: false, href: links.devlog });

          if (entries.length > 0) {
            detailCta.removeAttribute("hidden");
            entries.forEach((entry) => {
              const a = document.createElement("a");
              a.href = entry.href;
              a.textContent = entry.label;
              if (entry.primary) a.classList.add("is-primary");
              if (entry.href.startsWith("http")) {
                a.rel = "noreferrer noopener";
                a.target = "_blank";
              }
              detailCta.append(a);
            });
          } else {
            detailCta.setAttribute("hidden", "");
          }
        }

        if (shouldPulse) {
          card.classList.remove("is-pulsing");
          void card.offsetWidth;
          card.classList.add("is-pulsing");
        }
      };

      const openDetail = (card) => {
        setActiveCard(card);
        shell?.classList.add("is-detail-open");
        detail?.setAttribute("aria-hidden", "false");
        detail?.classList.remove("is-entering");
        if (detail) void detail.offsetWidth;
        detail?.classList.add("is-entering");
      };

      const closeDetail = () => {
        shell?.classList.remove("is-detail-open");
        detail?.setAttribute("aria-hidden", "true");
      };

      const stepDetail = (direction) => {
        const nextIndex = (activeIndex + direction + cards.length) % cards.length;
        const nextCard = cards[nextIndex];
        if (nextCard) setActiveCard(nextCard);
      };

      const animate = () => {
        if (!paused && shell?.dataset.mode !== "grid" && !shell?.classList.contains("is-detail-open")) {
          spin += 0.035;
        }

        if (shell?.dataset.mode === "deck") {
          deckPosition += (deckTarget - deckPosition) * 0.12;
          if (Math.abs(deckTarget - deckPosition) < 0.001) deckPosition = deckTarget;
          updateDeck();
        }

        setVars();
        requestAnimationFrame(animate);
      };

      scene?.addEventListener("pointerdown", (event) => {
        if (shell?.classList.contains("is-detail-open")) return;
        if (shell?.dataset.mode === "deck") return;

        if (event.target instanceof Element && event.target.closest("[data-world-card]")) return;

        pointerDown = true;
        startX = event.clientX;
        startY = event.clientY;
        startDragX = dragX;
        startDragY = dragY;
        scene.setPointerCapture(event.pointerId);
        shell?.classList.add("is-dragging");
      });

      scene?.addEventListener("pointermove", (event) => {
        const mx = event.clientX / window.innerWidth - 0.5;
        const my = event.clientY / window.innerHeight - 0.5;
        root.style.setProperty("--mx", mx.toFixed(4));
        root.style.setProperty("--my", my.toFixed(4));
        cursor?.style.setProperty("--cx", `${event.clientX}px`);
        cursor?.style.setProperty("--cy", `${event.clientY}px`);

        if (!pointerDown || shell?.dataset.mode === "deck") return;

        dragX = startDragX + (event.clientX - startX) * 0.22;
        dragY = Math.max(-42, Math.min(34, startDragY - (event.clientY - startY) * 0.18));
      });

      scene?.addEventListener("pointerup", (event) => {
        if (!pointerDown) return;

        pointerDown = false;
        if (scene.hasPointerCapture(event.pointerId)) {
          scene.releasePointerCapture(event.pointerId);
        }
        shell?.classList.remove("is-dragging");
      });

      scene?.addEventListener("pointercancel", (event) => {
        if (shell?.dataset.mode === "deck" && deckPointerDown) {
          deckPointerDown = false;
          deckWasDragged = false;
          if (scene.hasPointerCapture(event.pointerId)) {
            scene.releasePointerCapture(event.pointerId);
          }
          return;
        }

        if (!pointerDown) return;

        pointerDown = false;
        if (scene.hasPointerCapture(event.pointerId)) {
          scene.releasePointerCapture(event.pointerId);
        }
        shell?.classList.remove("is-dragging");
      });

      cards.forEach((card) => {
        card.addEventListener("pointerdown", (event) => {
          if (shell?.dataset.mode === "deck") {
            startX = event.clientX;
            startY = event.clientY;
            deckWasDragged = false;
          }

          event.stopPropagation();
        });

        card.addEventListener("click", (event) => {
          event.stopPropagation();

          if (skipNextCardClick) {
            skipNextCardClick = false;
            return;
          }

          if (deckWasDragged) {
            deckWasDragged = false;
            return;
          }

          if (shell?.dataset.mode === "deck" && card.getAttribute("data-deck-current") === null) {
            selectDeckCard(card);
            return;
          }

          openDetail(card);
        });

        card.addEventListener("pointerenter", () => {
          shell?.setAttribute("data-active-tone", card.dataset.tone || "acid");
        });
      });

      document.addEventListener(
        "pointerdown",
        (event) => {
          if (
            shell?.dataset.mode !== "deck" ||
            shell.classList.contains("is-detail-open") ||
            isInterfaceInput(event.target)
          ) {
            return;
          }

          startX = event.clientX;
          startY = event.clientY;
          deckWasDragged = false;
          deckPointerDown = true;
          shell.classList.add("is-dragging");
        },
        true,
      );

      document.addEventListener(
        "pointermove",
        (event) => {
          if (shell?.dataset.mode !== "deck" || !deckPointerDown) return;

          const distanceX = event.clientX - startX;
          const distanceY = event.clientY - startY;
          deckWasDragged = Math.abs(distanceX) > 10 || Math.abs(distanceY) > 12;
        },
        true,
      );

      scene?.addEventListener("wheel", (event) => {
        if (shell?.classList.contains("is-detail-open") || shell?.dataset.mode !== "deck") return;

        event.preventDefault();
        const primaryDelta = Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.deltaY;
        deckTarget += primaryDelta * 0.006;
      }, { passive: false });

      document.addEventListener(
        "pointerup",
        (event) => {
        if (shell?.dataset.mode !== "deck" || !deckPointerDown) return;

        deckPointerDown = false;
        if (scene.hasPointerCapture(event.pointerId)) {
          scene.releasePointerCapture(event.pointerId);
        }
        shell.classList.remove("is-dragging");

        const distanceX = event.clientX - startX;
        const distanceY = event.clientY - startY;
        const didSwipe = Math.abs(distanceX) > 24 && Math.abs(distanceX) > Math.abs(distanceY) * 0.72;

        if (didSwipe) {
          deckWasDragged = false;
          moveDeck(distanceX < 0 ? 1 : -1);
          return;
        }

        if (!deckWasDragged) {
          selectDeckCard(getDeckCardAtPoint(event.clientX, event.clientY));
        }

        deckWasDragged = false;
        },
        true,
      );

      document.addEventListener(
        "pointercancel",
        () => {
          if (shell?.dataset.mode !== "deck" || !deckPointerDown) return;

          deckPointerDown = false;
          deckWasDragged = false;
          shell.classList.remove("is-dragging");
        },
        true,
      );

      document.addEventListener(
        "pointerdown",
        (event) => {
          if (
            shell?.dataset.mode !== "world" ||
            shell.classList.contains("is-detail-open") ||
            isInterfaceInput(event.target)
          ) {
            return;
          }

          startX = event.clientX;
          startY = event.clientY;
          worldWasDragged = false;
          worldPointerDown = true;
        },
        true,
      );

      document.addEventListener(
        "pointermove",
        (event) => {
          if (shell?.dataset.mode !== "world" || !worldPointerDown) return;

          const distanceX = event.clientX - startX;
          const distanceY = event.clientY - startY;
          worldWasDragged = Math.abs(distanceX) > 10 || Math.abs(distanceY) > 12;
        },
        true,
      );

      document.addEventListener(
        "pointerup",
        (event) => {
          if (shell?.dataset.mode !== "world" || !worldPointerDown) return;

          worldPointerDown = false;

          if (!worldWasDragged) {
            const hasNativeCardClick =
              event.target instanceof Element && Boolean(event.target.closest("[data-world-card]"));
            selectWorldCard(getWorldCardAtPoint(event.clientX, event.clientY), hasNativeCardClick);
          }

          worldWasDragged = false;
        },
        true,
      );

      document.addEventListener(
        "pointercancel",
        () => {
          if (shell?.dataset.mode !== "world" || !worldPointerDown) return;

          worldPointerDown = false;
          worldWasDragged = false;
        },
        true,
      );

      randomButton?.addEventListener("click", () => {
        const next = cards[Math.floor(Math.random() * cards.length)];
        if (next) openDetail(next);
      });

      resetButton?.addEventListener("click", () => {
        dragX = 0;
        dragY = -9;
        spin = 0;
        deckPosition = 0;
        deckTarget = 0;
        updateDeck();
        setMode("grid");
        closeDetail();
      });

      pauseButton?.addEventListener("click", () => {
        paused = !paused;
        pauseButton.setAttribute("aria-pressed", String(paused));
        shell?.classList.toggle("is-paused", paused);
      });

      modeButtons.forEach((button) => {
        button.addEventListener("click", () => {
          closeDetail();
          setMode(button.dataset.modeButton || "world");
        });
      });

      const heroCaseStudy = document.querySelector("[data-hero-case-study]");
      heroCaseStudy?.addEventListener("click", () => {
        const featuredCard = cards[0];
        if (featuredCard) openDetail(featuredCard);
      });

      detailClose?.addEventListener("click", closeDetail);
      detailPrev?.addEventListener("click", () => stepDetail(-1));
      detailNext?.addEventListener("click", () => stepDetail(1));

      document.addEventListener("keydown", (event) => {
        if (!shell?.classList.contains("is-detail-open")) return;

        if (event.key === "Escape") closeDetail();
        if (event.key === "ArrowLeft") stepDetail(-1);
        if (event.key === "ArrowRight") stepDetail(1);
      });

      cards[0] && setActiveCard(cards[0]);
      updateDeck();

      const initialMode = new URLSearchParams(window.location.search).get("mode");
      if (initialMode === "world" || initialMode === "grid" || initialMode === "deck") {
        setMode(initialMode);
      }

      const initialProjectParam = new URLSearchParams(window.location.search).get("project");
      const initialProject = initialProjectParam === null ? NaN : Number(initialProjectParam);
      if (Number.isInteger(initialProject) && cards[initialProject]) {
        window.setTimeout(() => openDetail(cards[initialProject]), 240);
      }

      // Decoded text effect on hero title
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const decodeTargets = document.querySelectorAll("[data-decode-text]");
      const decodeGlyphs = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#@*+";
      decodeTargets.forEach((el) => {
        const original = el.textContent || "";
        el.setAttribute("aria-label", original);
        if (reduceMotion) return;
        el.textContent = "";
        const chars = [...original];
        chars.forEach((char, i) => {
          const span = document.createElement("span");
          span.className = "decoded-char";
          if (char === " ") {
            span.innerHTML = "&nbsp;";
          } else {
            span.textContent = char;
            span.dataset.noise = decodeGlyphs[Math.floor(Math.random() * decodeGlyphs.length)];
          }
          el.appendChild(span);
        });
        const charsList = el.querySelectorAll(".decoded-char");
        const total = charsList.length;
        const start = performance.now();
        const duration = 720;
        const cycleNoise = (now) => {
          const t = Math.min(1, (now - start) / duration);
          el.style.setProperty("--decode-progress", String(t));
          charsList.forEach((c, i) => {
            const localT = Math.max(0, Math.min(1, (t - i / total / 1.6) * 2.4));
            if (localT >= 1) {
              c.dataset.noise = "";
            } else if (c.dataset.noise !== undefined) {
              c.dataset.noise = decodeGlyphs[Math.floor(Math.random() * decodeGlyphs.length)];
            }
          });
          if (t < 1) requestAnimationFrame(cycleNoise);
        };
        requestAnimationFrame(cycleNoise);
      });

      // Live ticker — track current mode & visible project for the marquee
      const tickerMarquee = document.querySelector("[data-ticker-marquee]");
      const updateTicker = () => {
        if (!tickerMarquee) return;
        const mode = (shell?.dataset.mode || "grid").toUpperCase();
        const tone = (shell?.dataset.activeTone || "").toUpperCase();
        const fps = 60 + Math.floor(Math.random() * 5);
        tickerMarquee.textContent = `BUILD::PASS · MODE::${mode} · TONE::${tone} · FPS ${fps} · LATENCY ${10 + Math.floor(Math.random() * 8)}ms`;
      };
      updateTicker();
      if (!reduceMotion) setInterval(updateTicker, 2400);

      animate();
    })();
  </script>
</Layout>
