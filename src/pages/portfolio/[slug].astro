---
import Layout from "../../components/Layout.astro";
import "../../styles/portfolio.css";
import { projects, getProjectBySlug } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.id } }));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug!);
if (!project) {
  return Astro.redirect("/portfolio");
}
const sourceHref = project.links.source;
const teamPeriod = [project.team, project.period].filter(Boolean).join(" · ");
type MetricPart = { type: "metric" | "text"; value: string };
const renderMetrics = (text: string): MetricPart[] =>
  text.split(/(\[\[.+?\]\])/g).map((part) => {
    const match = part.match(/^\[\[(.+)\]\]$/);
    return match
      ? { type: "metric" as const, value: match[1] }
      : { type: "text" as const, value: part };
  });
---

<Layout
  title={`${project.title} — HyeongJun Yoo`}
  description={project.summary}
>
  <div class="world-shell" data-world-shell data-mode="detail" data-active-tone={project.tone}>
    <div class="detail-progress" aria-hidden="true">
      <div class="detail-progress-fill"></div>
    </div>
    <div class="world-grain" aria-hidden="true"></div>
    <div class="scanlines" aria-hidden="true"></div>
    <div class="cursor-light" data-cursor aria-hidden="true"></div>

    <div class="system-ticker" aria-hidden="true">
      <span class="ticker-segment">
        <span class="ticker-dot"></span>
        <span class="ticker-label">SYS</span>
        <span class="ticker-value">ONLINE</span>
      </span>
      <span class="ticker-marquee">DETAIL::{project.id.toUpperCase()} · TONE::{project.tone.toUpperCase()}</span>
      <span class="ticker-segment">
        <span class="ticker-label">v</span>
        <span class="ticker-value">0.0.4</span>
      </span>
    </div>

    <header class="world-header" aria-label="Site navigation">
      <a class="site-mark" href="/portfolio">● HYEONGJUN YOO <span>/ Game Programmer</span></a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/">Resume</a>
      </nav>
    </header>

    <main id="main" data-tone={project.tone}>
      <section class="project-detail-page" aria-labelledby="detail-title" data-tone={project.tone}>
        <div class="detail-hero-media hud-frame" aria-hidden="true">
          <span class="hud-corner-tr"></span>
          <span class="hud-corner-bl"></span>
          <img src={project.image} alt="" fetchpriority="high" decoding="async" />
          <span class="detail-hero-scrim"></span>
        </div>

        <article class="detail-content">
          <div class="detail-intro-card" id="top">
            <header class="detail-header">
              <h1 id="detail-title" class="detail-title">{project.title}</h1>
              {sourceHref && (
                <a
                  class="detail-source"
                  href={sourceHref}
                  rel={sourceHref.startsWith("http") ? "noreferrer noopener" : undefined}
                  target={sourceHref.startsWith("http") ? "_blank" : undefined}
                >▸ View Source</a>
              )}
            </header>

            <dl class="detail-meta">
              <div>
                <dt>Engine</dt>
                <dd>{project.engine}</dd>
              </div>
              <div>
                <dt>Platform</dt>
                <dd>{project.platform}</dd>
              </div>
              <div>
                <dt>Role</dt>
                <dd>{project.role}</dd>
              </div>
              <div>
                <dt>Team / Period</dt>
                <dd>{teamPeriod}</dd>
              </div>
            </dl>

            {project.stack.length > 0 && (
              <div class="detail-stack">
                {project.stack.map((item) => <span>{item}</span>)}
              </div>
            )}
          </div>

          <div class="detail-divider" data-tone={project.tone} aria-hidden="true"></div>

          <section class="detail-narrative" id="goal">
            <h3>Project goal</h3>
            <p>{project.goal}</p>
          </section>

          <div class="detail-divider" data-tone={project.tone} aria-hidden="true"></div>

          {project.challenges.length > 0 && (
            <section class="detail-challenges" aria-label="Challenges and solutions">
              <div class="detail-challenges-intro" id="cases">
                <h3 class="detail-challenges-heading">Challenges &amp; Solutions</h3>
                {project.challengeIntro && (
                  <p>{project.challengeIntro}</p>
                )}
              </div>
              <ol class="detail-challenges-list">
                {project.challenges.map((challenge, index) => (
                  <li
                    class="detail-challenge"
                    id={`challenge-${index + 1}`}
                  >
                    <header class="detail-challenge-head">
                      <span class="detail-challenge-index">{String(index + 1).padStart(2, "0")}</span>
                      <h4 class="detail-challenge-title">{challenge.title}</h4>
                    </header>
                    {challenge.image && (
                      <img
                        class="detail-challenge-image"
                        src={challenge.image}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        draggable={false}
                      />
                    )}
                    <div class="detail-challenge-block">
                      <span class="detail-challenge-label">문제 원인</span>
                      <p>
                        {renderMetrics(challenge.problem).map((part) =>
                          part.type === "metric"
                            ? <span class="metric">{part.value}</span>
                            : part.value
                        )}
                      </p>
                    </div>
                    <div class="detail-challenge-block">
                      <span class="detail-challenge-label">해결 과정</span>
                      <p>
                        {renderMetrics(challenge.solution).map((part) =>
                          part.type === "metric"
                            ? <span class="metric">{part.value}</span>
                            : part.value
                        )}
                      </p>
                    </div>
                    {challenge.outcome && (
                      <div class="detail-challenge-block">
                        <span class="detail-challenge-label">결과</span>
                        <p>
                          {renderMetrics(challenge.outcome).map((part) =>
                            part.type === "metric"
                              ? <span class="metric">{part.value}</span>
                              : part.value
                          )}
                        </p>
                      </div>
                    )}
                  </li>
                ))}
              </ol>
            </section>
          )}
        </article>

        <nav class="detail-challenge-nav" aria-label="Page navigation">
          <a href="#top" data-nav-target="top">
            <span class="nav-dot" aria-hidden="true"></span>
            <span class="nav-label">TOP</span>
          </a>
          <a href="#goal" data-nav-target="goal">
            <span class="nav-dot" aria-hidden="true"></span>
            <span class="nav-label">GOAL</span>
          </a>
          {project.challenges.length > 0 && (
            <>
              <a href="#cases" data-nav-target="cases">
                <span class="nav-dot" aria-hidden="true"></span>
                <span class="nav-label">CASES</span>
              </a>
              {project.challenges.map((_c, i) => (
                <a href={`#challenge-${i + 1}`} data-nav-target={`challenge-${i + 1}`}>
                  <span class="nav-dot" aria-hidden="true"></span>
                  <span class="nav-label">{String(i + 1).padStart(2, "0")}</span>
                </a>
              ))}
            </>
          )}
        </nav>

      </section>
    </main>

    <footer class="portfolio-footer" id="contact">
      <p class="portfolio-footer-about" id="about">
        Game programmer. Unity / Unreal · multiplayer · tools · tech-art-friendly.
      </p>
      <p class="portfolio-footer-links">
        <a href="mailto:yoojoo97@gmail.com">yoojoo97@gmail.com</a>
        <a href="https://github.com/HyeongJunYoo" rel="noreferrer noopener" target="_blank">GitHub</a>
        <a href="https://www.linkedin.com/" rel="noreferrer noopener" target="_blank">LinkedIn</a>
      </p>
    </footer>
  </div>

  <script is:inline>
    (() => {
      const root = document.documentElement;
      const cursor = document.querySelector("[data-cursor]");
      if (!cursor) return;
      window.addEventListener("pointermove", (event) => {
        const mx = event.clientX / window.innerWidth - 0.5;
        const my = event.clientY / window.innerHeight - 0.5;
        root.style.setProperty("--mx", mx.toFixed(4));
        root.style.setProperty("--my", my.toFixed(4));
        cursor.style.setProperty("--cx", `${event.clientX}px`);
        cursor.style.setProperty("--cy", `${event.clientY}px`);
      });
    })();
    (() => {
      // Page-wide TOC scrollspy — picks the section whose top is the most
      // recent to cross the 35% line from viewport top. Position-based
      // (not IntersectionObserver) so a short section like CASES doesn't
      // get skipped over by a taller challenge below it.
      const navLinks = document.querySelectorAll('.detail-challenge-nav a');
      if (navLinks.length === 0) return;
      const targets = [
        document.getElementById('top'),
        document.getElementById('goal'),
        document.getElementById('cases'),
        ...document.querySelectorAll('.detail-challenge[id]'),
      ].filter(Boolean);
      if (targets.length === 0) return;
      let raf = 0;
      const update = () => {
        // Threshold = top 10% of viewport. A section becomes active when
        // its top crosses this line going up; the section above stays
        // active until the next one crosses. Tighter than 35% so short
        // sections (CASES is ~150px) aren't shadowed by taller ones.
        const threshold = window.innerHeight * 0.1;
        let active = targets[0].id;
        for (const t of targets) {
          if (t.getBoundingClientRect().top <= threshold) {
            active = t.id;
          }
        }
        // Near-bottom snap: when user has scrolled to within 80px of the
        // page bottom, force-active the last section. Without this, the
        // last section's top often can't reach the threshold (page runs
        // out of scroll first) and the previous section stays highlighted.
        if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 80) {
          active = targets[targets.length - 1].id;
        }
        navLinks.forEach((a) => {
          a.classList.toggle('is-active', a.dataset.navTarget === active);
        });
        raf = 0;
      };
      window.addEventListener('scroll', () => {
        if (!raf) raf = requestAnimationFrame(update);
      }, { passive: true });
      update();
    })();
    (() => {
      const progressFill = document.querySelector('.detail-progress-fill');
      if (!progressFill) return;
      let raf = 0;
      const update = () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const pct = max > 0 ? Math.min(100, Math.max(0, (window.scrollY / max) * 100)) : 0;
        progressFill.style.width = `${pct}%`;
        raf = 0;
      };
      window.addEventListener('scroll', () => {
        if (!raf) raf = requestAnimationFrame(update);
      }, { passive: true });
      update();
    })();
  </script>
</Layout>
