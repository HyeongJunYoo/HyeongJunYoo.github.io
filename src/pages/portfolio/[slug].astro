---
import Layout from "../../components/Layout.astro";
import "../../styles/portfolio.css";
import { projects, getProjectBySlug } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.id } }));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug!);
if (!project) {
  return Astro.redirect("/portfolio");
}
const sourceHref = project.links.source;
const teamPeriod = [project.team, project.period].filter(Boolean).join(" · ");
---

<Layout
  title={`${project.title} — HyeongJun Yoo`}
  description={project.summary}
>
  <div class="world-shell" data-world-shell data-mode="detail" data-active-tone={project.tone}>
    <div class="world-grain" aria-hidden="true"></div>
    <div class="scanlines" aria-hidden="true"></div>
    <div class="cursor-light" data-cursor aria-hidden="true"></div>

    <div class="system-ticker" aria-hidden="true">
      <span class="ticker-segment">
        <span class="ticker-dot"></span>
        <span class="ticker-label">SYS</span>
        <span class="ticker-value">ONLINE</span>
      </span>
      <span class="ticker-marquee">DETAIL::{project.id.toUpperCase()} · TONE::{project.tone.toUpperCase()}</span>
      <span class="ticker-segment">
        <span class="ticker-label">v</span>
        <span class="ticker-value">0.0.4</span>
      </span>
    </div>

    <header class="world-header" aria-label="Site navigation">
      <a class="site-mark" href="/portfolio">● HYEONGJUN YOO <span>/ Game Programmer</span></a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/">Resume</a>
      </nav>
    </header>

    <main id="main" data-tone={project.tone}>
      <section class="project-detail-page" aria-labelledby="detail-title" data-tone={project.tone}>
        <div class="detail-hero-media hud-frame" aria-hidden="true">
          <span class="hud-corner-tr"></span>
          <span class="hud-corner-bl"></span>
          <img src={project.image} alt="" fetchpriority="high" decoding="async" />
          <span class="detail-hero-scrim"></span>
        </div>

        <article class="detail-content">
          <div class="detail-intro-card">
            <header class="detail-header">
              <h1 id="detail-title" class="detail-title">{project.title}</h1>
              {sourceHref && (
                <a
                  class="detail-source"
                  href={sourceHref}
                  rel={sourceHref.startsWith("http") ? "noreferrer noopener" : undefined}
                  target={sourceHref.startsWith("http") ? "_blank" : undefined}
                >▸ View Source</a>
              )}
            </header>

            <dl class="detail-meta">
              <div>
                <dt>Engine</dt>
                <dd>{project.engine}</dd>
              </div>
              <div>
                <dt>Platform</dt>
                <dd>{project.platform}</dd>
              </div>
              <div>
                <dt>Role</dt>
                <dd>{project.role}</dd>
              </div>
              <div>
                <dt>Team / Period</dt>
                <dd>{teamPeriod}</dd>
              </div>
            </dl>

            {project.stack.length > 0 && (
              <div class="detail-stack">
                {project.stack.map((item) => <span>{item}</span>)}
              </div>
            )}
          </div>

          <section class="detail-narrative">
            <h3>Project goal</h3>
            <p>{project.goal}</p>
          </section>

          {project.challenges.length > 0 && (
            <section class="detail-challenges" aria-label="Challenges and solutions">
              <h3 class="detail-challenges-heading">Challenges &amp; Solutions</h3>
              <ol class="detail-challenges-list">
                {project.challenges.map((challenge, index) => (
                  <li class="detail-challenge">
                    <header class="detail-challenge-head">
                      <span class="detail-challenge-index">{String(index + 1).padStart(2, "0")}</span>
                      <h4 class="detail-challenge-title">{challenge.title}</h4>
                    </header>
                    {challenge.image && (
                      <img
                        class="detail-challenge-image"
                        src={challenge.image}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        draggable={false}
                      />
                    )}
                    <div class="detail-challenge-block">
                      <span class="detail-challenge-label">문제 원인</span>
                      <p>{challenge.problem}</p>
                    </div>
                    <div class="detail-challenge-block">
                      <span class="detail-challenge-label">해결 과정</span>
                      <p>{challenge.solution}</p>
                    </div>
                    {challenge.outcome && (
                      <div class="detail-challenge-block">
                        <span class="detail-challenge-label">결과</span>
                        <p>{challenge.outcome}</p>
                      </div>
                    )}
                  </li>
                ))}
              </ol>
            </section>
          )}
        </article>

      </section>
    </main>

    <footer class="portfolio-footer" id="contact">
      <p class="portfolio-footer-about" id="about">
        Game programmer. Unity / Unreal · multiplayer · tools · tech-art-friendly.
      </p>
      <p class="portfolio-footer-links">
        <a href="mailto:yoojoo97@gmail.com">yoojoo97@gmail.com</a>
        <a href="https://github.com/HyeongJunYoo" rel="noreferrer noopener" target="_blank">GitHub</a>
        <a href="https://www.linkedin.com/" rel="noreferrer noopener" target="_blank">LinkedIn</a>
      </p>
    </footer>
  </div>

  <script is:inline>
    (() => {
      const root = document.documentElement;
      const cursor = document.querySelector("[data-cursor]");
      if (!cursor) return;
      window.addEventListener("pointermove", (event) => {
        const mx = event.clientX / window.innerWidth - 0.5;
        const my = event.clientY / window.innerHeight - 0.5;
        root.style.setProperty("--mx", mx.toFixed(4));
        root.style.setProperty("--my", my.toFixed(4));
        cursor.style.setProperty("--cx", `${event.clientX}px`);
        cursor.style.setProperty("--cy", `${event.clientY}px`);
      });
    })();
  </script>
</Layout>
